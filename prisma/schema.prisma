// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  DIRECT
  GROUP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentMessages       Message[]
  participations     Participation[]
  blockedUsers       Block[]                 @relation("UserBlocks")
  blockedByUsers     Block[]                 @relation("UserBlockedBy")
  realtimeDeliveries RealtimeEventDelivery[]
}

model Conversation {
  id             String           @id @default(cuid())
  type           ConversationType
  title          String?
  participantKey String?          @unique
  lastMessageId  String?          @unique
  lastMessage    Message?         @relation("LastMessage", fields: [lastMessageId], references: [id])
  lastMessageAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  participants   Participation[]
  messages       Message[]       @relation("ConversationMessages")
  realtimeEvents RealtimeEvent[]

  @@index([lastMessageAt])
}

model Participation {
  userId            String
  conversationId    String
  createdAt         DateTime  @default(now())
  unreadCount       Int       @default(0)
  lastReadMessageId String?
  lastReadAt        DateTime?

  user            User         @relation(fields: [userId], references: [id])
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  lastReadMessage Message?     @relation("ParticipationLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@id([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String   @id @default(cuid())
  senderId       String
  conversationId String
  clientId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender               User            @relation(fields: [senderId], references: [id])
  conversation         Conversation    @relation("ConversationMessages", fields: [conversationId], references: [id])
  latestInConversation Conversation?   @relation("LastMessage")
  readBy               Participation[] @relation("ParticipationLastReadMessage")

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt, id])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id])
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model RealtimeEvent {
  id             String   @id @default(cuid())
  type           String
  version        Int      @default(1)
  conversationId String
  payload        Json
  occurredAt     DateTime @default(now())
  expiresAt      DateTime

  conversation Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries   RealtimeEventDelivery[]

  @@index([conversationId, occurredAt, id])
  @@index([expiresAt])
}

model RealtimeEventDelivery {
  eventId String
  userId  String

  event RealtimeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, eventId])
}
