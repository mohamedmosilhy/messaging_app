{
  "name": "messaging_app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "knip": {
    "ignoreDependencies": [
      "@prisma/client",
      "pg"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:seeded": "prisma db seed && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "CAPTURE_SCREENSHOTS=true playwright test tests/e2e/screenshots.spec.ts --project=desktop",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "@tanstack/react-query": "^5.101.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.8.4",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
