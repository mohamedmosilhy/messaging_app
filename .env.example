# PostgreSQL connection used by Prisma and the application.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messaging_app

# Generate a long random value for every deployed environment.
AUTH_SECRET=replace-with-a-long-random-secret

# Public application URL. Change this to the deployed origin in production.
AUTH_URL=http://localhost:3000

# bcrypt cost factor. The application currently defaults to 10.
HASHING_SALT=10
